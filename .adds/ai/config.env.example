ASK_AI_BACKEND="lua"
DEFAULT_PROVIDER="openai"
DEFAULT_REQUEST_TYPE="explain_selection"
# Optional: override the runtime state directory used for requests.db, logs, and temp files.
# By default this uses /mnt/onboard/.adds/ai so the live cache stays visible on the device.
# ASK_AI_STATE_DIR="/some/other/path"
OPENAI_API_KEY="sk-your-api-key-here"
OPENAI_MODEL="gpt-4.1-mini"
PROMPT_TEMPLATE="/mnt/onboard/.adds/ai/prompt_template.tmpl"
